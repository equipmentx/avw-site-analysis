# ──────────────────────────────────────────────────────────────
# CarWash Intel — environment template
#
# Copy to .env.local and fill in. Never commit .env.local.
# Required = app will not function.
# Recommended = feature degrades without it.
# Optional = feature disabled without it (app still runs).
# ──────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────
# Google Maps — Maps JS + Places + Geocoding + Street View + Static Maps.
# Create TWO keys in Google Cloud Console:
#   1. Browser key with HTTP-referrer restriction → NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
#   2. Server key with IP restriction (after Vercel deploy) → GOOGLE_MAPS_API_KEY
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# ── STRONGLY RECOMMENDED ─────────────────────────────────────
# TomTom — AADT / traffic flow (developer.tomtom.com — free tier covers dev)
TOMTOM_API_KEY=

# ATTOM Data — US parcel / assessor records (attomdata.com)
ATTOM_API_KEY=

# US Census ACS — demographics (api.census.gov/data/key_signup.html — free, instant)
CENSUS_ACS_API_KEY=

# BLS — CPI inflation adjust for financial model
# No key = 25 req/day; with key = 500 req/day (data.bls.gov/registrationEngine)
BLS_API_KEY=

# ── OPTIONAL ─────────────────────────────────────────────────
# Regrid — alt US parcel data (regrid.com/docs/api/v2)
REGRID_API_KEY=

# SerpAPI — competitor web-search enrichment (serpapi.com)
SERPAPI_KEY=

# AI decision enrichment — set one or both. Claude is preferred.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# FX rates — FRED (US Fed) for USD/GBP/EUR/etc.; works without key but rate-limited.
FRED_API_KEY=

# Open Exchange Rates — FX for currencies not in FRED (NGN, GHS, KES, AED).
# Sign up at openexchangerates.org for a free App ID.
OPEN_EXCHANGE_RATES_APP_ID=

# ── METADATA ─────────────────────────────────────────────────
# Public site URL — used for OpenGraph image URLs. Default is the Vercel URL.
NEXT_PUBLIC_SITE_URL=https://avw-site-analysis.vercel.app
